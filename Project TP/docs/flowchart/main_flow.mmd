flowchart TD
    Start([Mulai Program]) --> Init["Inisialisasi Data Global: Menu, Harga, Stok, Cart, Reports, Settings, Waktu"]
    Init --> Dashboard["Dashboard Utama"]
    Dashboard --> MenuChoice{"Pilih Menu"}

    MenuChoice -->|"1. Menu & Pesanan"| Category["Pilih Kategori: Makanan Berat, Drinks, Deserts"]
    Category --> PickItem["Pilih Item + Qty"]
    PickItem --> StockCheck{"Stok Cukup?"}
    StockCheck -->|"Ya"| AddCart["Masukkan ke Cart"]
    StockCheck -->|"Tidak"| NoStock["Stok Tidak Cukup"]
    AddCart --> LowStockCheck1{"Stok Menipis?"}
    LowStockCheck1 -->|"Ya"| LowStockNotif1["Low Stock Notification"]
    LowStockCheck1 -->|"Tidak"| Dashboard
    LowStockNotif1 --> Dashboard
    NoStock --> Dashboard

    MenuChoice -->|"2. Keranjang"| ViewCart["Tampilkan Belanja & Total"]
    ViewCart --> CartAction{"Pilih Aksi"}
    CartAction -->|"Hapus Item"| RemoveItem["Hapus Item"]
    RemoveItem --> ViewCart
    CartAction -->|"Checkout"| CheckoutFlow["Alur Checkout (checkout_flow)"]
    CheckoutFlow --> LowStockCheck2{"Stok Menipis?"}
    LowStockCheck2 -->|"Ya"| LowStockNotif2["Low Stock Notification"]
    LowStockCheck2 -->|"Tidak"| Dashboard
    LowStockNotif2 --> Dashboard

    MenuChoice -->|"3. Inventory"| InvFlow["Alur Inventory (inventory_flow)"]
    InvFlow --> Dashboard

    MenuChoice -->|"4. Laporan & Refund"| ReportMenu{"Pilih Aksi"}
    ReportMenu -->|"Riwayat & Daily Sales Summary"| ViewReport["Tampilkan Laporan & Pendapatan"]
    ReportMenu -->|"Cancel Order & Refund"| RefundFlow["Alur Refund (refund_flow)"]
    ViewReport --> Dashboard
    RefundFlow --> Dashboard

    MenuChoice -->|"5. Pengaturan"| Settings["Ubah Pengaturan Toko / Pajak"]
    Settings --> Dashboard

    MenuChoice -->|"6. Keluar"| End([Program Selesai])